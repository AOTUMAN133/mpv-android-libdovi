+/*
+ * 10-bit streams decoded to ByteBuffers come out as 8-bit NV12 unless the
+ * codec is asked for COLOR_FormatYUVP010 explicitly. Android 13's CTS makes
+ * P010 output mandatory for every decoder that supports a 10-bit profile,
+ * so on API >= 33 the request is safe; should a codec reject it anyway,
+ * ff_mediacodec_dec_init retries the configure without it.
+ */
+static int mediacodec_request_p010(AVCodecContext *avctx, MediaCodecDecContext *s,
+                                   FFAMediaFormat *format)
+{
+    int is_10bit;
+
+    if (s->surface)
+        return 0;
+
+    switch (avctx->codec_id) {
+    case AV_CODEC_ID_HEVC:
+        /* Some DV P5 encodes do not signal Main10 cleanly, but every
+         * Dolby Vision stream is 10-bit — and mediacodec_dovi_init has
+         * already parsed the configuration record by this point. */
+        is_10bit = avctx->profile == AV_PROFILE_HEVC_MAIN_10 || s->dovi != NULL;
+        break;
+    case AV_CODEC_ID_VP9:
+        is_10bit = avctx->profile == AV_PROFILE_VP9_2;
+        break;
+    default:
+        is_10bit = 0;
+    }
+    /* android_get_device_api_level() reads ro.build.version.sdk through
+     * the NDK; unlike ff_Build_SDK_INT it does not need a JavaVM, which
+     * is never registered when mpv drives the pure-NDK codec path. */
+    if (!is_10bit || android_get_device_api_level() < 33)
+        return 0;
+
+    ff_AMediaFormat_setInt32(format, "color-format", COLOR_FormatYUVP010);
+    av_log(avctx, AV_LOG_INFO,
+           "Requesting P010 ByteBuffer output for the 10-bit stream\n");
+    return 1;
+}
