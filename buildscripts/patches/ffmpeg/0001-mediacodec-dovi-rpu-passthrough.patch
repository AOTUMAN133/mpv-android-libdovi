     if (avctx->codec_type == AVMEDIA_TYPE_AUDIO)
         ret = mediacodec_dec_get_audio_codec(avctx, s, mime, format);
     else if (avctx->codec_type == AVMEDIA_TYPE_VIDEO)
@@ -948,6 +1141,11 @@ int ff_mediacodec_dec_send(AVCodecContext *avctx, MediaCodecDecContext *s,
             pts = av_rescale_q(pts, avctx->pkt_timebase, AV_TIME_BASE_Q);
         }
 
+        /* Parse Dolby Vision RPUs once per packet, keyed by the same
