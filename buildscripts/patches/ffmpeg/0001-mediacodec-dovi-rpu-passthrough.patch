+/*
+ * Dolby Vision RPU passthrough.
+ *
+ * MediaCodec decodes the base layer but is a black box for metadata:
+ * unlike the hwaccel-style decoders, nothing here parses the RPU NALs
+ * riding along in the bitstream, so single-layer profile 5 content
+ * (IPTPQc2-encoded base layer) decodes to unwatchable colours unless
+ * the renderer gets the reshaping metadata.
+ *
+ * Parse UNSPEC62 NALs from input packets with lavc's own DOVI machinery
+ * and attach the resulting AVDOVIMetadata to the matching output frame,
+ * keyed by the microsecond timestamp MediaCodec round-trips losslessly.
+ * Renderers (e.g. libplacebo) then apply the reshape on the GPU.
+ */
+
+static void mediacodec_dovi_pending_clear(MediaCodecDecContext *s)
+{
+    int i;
+    for (i = 0; i < s->dovi_pending_count; i++)
+        av_buffer_unref(&s->dovi_pending[i].metadata);
+    s->dovi_pending_count = 0;
+}
+
+static void mediacodec_dovi_uninit(MediaCodecDecContext *s)
+{
+    mediacodec_dovi_pending_clear(s);
+    if (s->dovi) {
+        ff_dovi_ctx_unref(s->dovi);
+        av_freep(&s->dovi);
+    }
+}
+
+static void mediacodec_dovi_init(AVCodecContext *avctx, MediaCodecDecContext *s)
+{
+    const AVPacketSideData *sd;
+    const AVDOVIDecoderConfigurationRecord *cfg;
+
+    if (avctx->codec_id != AV_CODEC_ID_HEVC)
+        return;
+
+    sd = av_packet_side_data_get(avctx->coded_side_data, avctx->nb_coded_side_data,
+                                 AV_PKT_DATA_DOVI_CONF);
+    if (!sd || sd->size < sizeof(*cfg))
+        return;
+    cfg = (const AVDOVIDecoderConfigurationRecord *)sd->data;
+
+    /* Single-layer streams only: the base layer must stand alone
+     * (profile 5 = IPTPQc2 BL, profile 8 = HDR10/HLG-compatible BL).
+     * Dual-layer profile 7 reshaping needs the enhancement layer, which
+     * MediaCodec does not decode — leave those frames untouched. */
+    if (!cfg->dv_profile || !cfg->bl_present_flag || cfg->el_present_flag)
+        return;
+
+    s->dovi = av_mallocz(sizeof(*s->dovi));
+    if (!s->dovi)
+        return;
+    s->dovi->logctx = avctx;
+    s->dovi->cfg = *cfg;
+
+    av_log(avctx, AV_LOG_INFO,
+           "Dolby Vision profile %d: RPU passthrough enabled\n",
+           cfg->dv_profile);
+}
+
+static const uint8_t *mediacodec_find_startcode(const uint8_t *p, const uint8_t *end)
+{
+    for (; p + 3 <= end; p++) {
+        if (p[0] == 0 && p[1] == 0 && p[2] == 1)
+            return p + 3;
+    }
+    return NULL;
+}
+
+static void mediacodec_dovi_parse_packet(AVCodecContext *avctx, MediaCodecDecContext *s,
+                                         const AVPacket *pkt, int64_t pts_us)
+{
+    const uint8_t *p = pkt->data;
+    const uint8_t *end = pkt->data + pkt->size;
+
+    if (!s->dovi)
+        return;
+
+    while ((p = mediacodec_find_startcode(p, end))) {
+        const uint8_t *nal_end;
+        int nal_size, rbsp_size, zeros, nal_type, i;
+        uint8_t *rbsp;
+
+        /* This NAL runs to the next start code; strip trailing zeros
+         * (they belong to a four-byte start code or are padding). */
+        nal_end = mediacodec_find_startcode(p, end);
+        nal_end = nal_end ? nal_end - 3 : end;
+        while (nal_end > p && nal_end[-1] == 0)
+            nal_end--;
+        nal_size = nal_end - p;
+        if (nal_size < 3) {
+            p = nal_end;
+            continue;
+        }
+
+        nal_type = (p[0] >> 1) & 0x3f;
+        if (nal_type != 62 /* HEVC_NAL_UNSPEC62: Dolby Vision RPU */) {
+            p = nal_end;
+            continue;
+        }
+
+        /* Unescape (drop emulation prevention bytes). */
+        rbsp = av_malloc(nal_size);
+        if (!rbsp)
+            return;
+        rbsp_size = 0;
+        zeros = 0;
+        for (i = 0; i < nal_size; i++) {
+            if (zeros >= 2 && p[i] == 3 && i + 1 < nal_size && p[i + 1] <= 3) {
+                zeros = 0;
+                continue;
+            }
+            zeros = p[i] ? 0 : zeros + 1;
+            rbsp[rbsp_size++] = p[i];
+        }
+
+        /* Mirror hevcdec: skip the two-byte NAL header, parse, then
+         * snapshot the decoded metadata keyed by this AU's timestamp. */
+        if (rbsp_size > 2 &&
+            ff_dovi_rpu_parse(s->dovi, rbsp + 2, rbsp_size - 2,
+                              avctx->err_recognition) >= 0) {
+            AVDOVIMetadata *metadata = NULL;
+            int size = ff_dovi_get_metadata(s->dovi, &metadata);
+            if (size > 0) {
+                AVBufferRef *buf = av_buffer_create((uint8_t *)metadata, size,
+                                                    NULL, NULL, 0);
+                if (!buf) {
+                    av_free(metadata);
+                } else {
+                    if (s->dovi_pending_count == MEDIACODEC_DOVI_PENDING_MAX) {
+                        av_buffer_unref(&s->dovi_pending[0].metadata);
+                        memmove(&s->dovi_pending[0], &s->dovi_pending[1],
+                                sizeof(s->dovi_pending[0]) * --s->dovi_pending_count);
+                    }
+                    s->dovi_pending[s->dovi_pending_count].pts = pts_us;
+                    s->dovi_pending[s->dovi_pending_count].metadata = buf;
+                    s->dovi_pending_count++;
+                }
+            }
+        } else if (rbsp_size > 2) {
+            av_log(avctx, AV_LOG_VERBOSE, "Error parsing DOVI NAL unit.\n");
+        }
+
+        av_free(rbsp);
+        p = nal_end;
+    }
+}
+
+static void mediacodec_dovi_attach(MediaCodecDecContext *s, int64_t pts_us,
+                                   AVFrame *frame)
+{
+    int i;
+
+    if (!s->dovi)
+        return;
+
+    for (i = 0; i < s->dovi_pending_count; i++) {
+        if (s->dovi_pending[i].pts != pts_us)
+            continue;
+        if (!av_frame_new_side_data_from_buf(frame, AV_FRAME_DATA_DOVI_METADATA,
+                                             s->dovi_pending[i].metadata)) {
+            /* Attach failed — the buffer is still ours to drop. On
+             * success the frame took ownership. */
+            av_buffer_unref(&s->dovi_pending[i].metadata);
+        }
+        memmove(&s->dovi_pending[i], &s->dovi_pending[i + 1],
+                sizeof(s->dovi_pending[0]) * (s->dovi_pending_count - i - 1));
+        s->dovi_pending_count--;
+        return;
+    }
+}
